root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,html,js,css,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Language conventions
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Naming: private fields are _camelCase, constants and statics PascalCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly

# StyleCop: align with Jellyfin's code style
dotnet_diagnostic.SA1101.severity = none # no "this." prefix
dotnet_diagnostic.SA1309.severity = none # _camelCase private fields
dotnet_diagnostic.SA1633.severity = none # no file headers; the license is repository-wide
dotnet_diagnostic.SA1413.severity = none # trailing commas are optional
dotnet_diagnostic.SA1200.severity = none # usings outside file-scoped namespaces
dotnet_diagnostic.SA1000.severity = none # conflicts with target-typed new()
dotnet_diagnostic.SA1010.severity = none # conflicts with collection expressions
dotnet_diagnostic.SA1011.severity = none # conflicts with nullable array syntax
dotnet_diagnostic.SA1009.severity = none # conflicts with nullable/pattern syntax

# .NET analyzers: deliberate deviations from AllEnabledByDefault
dotnet_diagnostic.CA1062.severity = none # nullable reference types cover argument null checks
dotnet_diagnostic.CA1303.severity = none # no localization of exception/log strings
dotnet_diagnostic.CA1716.severity = none # "Core" and similar namespace segments are fine
dotnet_diagnostic.CA1724.severity = none # type names may match namespaces of dependencies
dotnet_diagnostic.CA1515.severity = none # this is a library loaded by Jellyfin, public types are intended
dotnet_diagnostic.CA2007.severity = warning # always ConfigureAwait(false) in library code

[tests/**.cs]
# Tests favour readability over library-grade rules
dotnet_diagnostic.CA1707.severity = none # Method_Names_With_Underscores
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none # xUnit has no synchronization context concerns
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1063.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1848.severity = none # LoggerMessage delegates are not needed in tests
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.CA5394.severity = none # Random is fine for test data
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none
