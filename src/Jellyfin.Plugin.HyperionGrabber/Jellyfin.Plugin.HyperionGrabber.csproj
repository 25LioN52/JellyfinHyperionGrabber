<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Thin Jellyfin adapter: plugin entry point, configuration page, admin API and Jellyfin event wiring.
    net9.0 builds for Jellyfin 10.11.x, net10.0 builds for Jellyfin 12.x.
  -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.HyperionGrabber</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host assemblies are supplied by the Jellyfin server; never ship them in the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.HyperionGrabber.Core\Jellyfin.Plugin.HyperionGrabber.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.HyperionGrabber.Tests" />
  </ItemGroup>

</Project>
